# local = reads/writes data/partners.local.json, zero setup
# live  = reads/writes the real Google Sheet via a service account
SHEETS_MODE=local

# Only needed when SHEETS_MODE=live and using a service account
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=necromancer-sheets@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Only needed when using the Apps Script proxy instead of a service account
APPS_SCRIPT_BASE_URL=https://script.google.com/macros/s/XXXX/exec
APPS_SCRIPT_API_KEY=your-apps-script-api-key
